{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "app.talix/stubs",
  "title": "Stubs",
  "description": "Pull one-time .env links from stubs.talix.app into a project. Returns key names, never values.",
  "version": "0.5.0",
  "websiteUrl": "https://stubs.talix.app",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@talix/stubs",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
