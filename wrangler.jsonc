{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stubs",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SECRET_BOX", "class_name": "SecretBox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SecretBox"] }],
  // Abuse guards, keyed per client IP in the worker.
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "4202",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "EVENTS_LIMITER",
      "namespace_id": "4203",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Analytics go to PostHog through /api/events. The project key is a secret:
  //   wrangler secret put POSTHOG_KEY
  "vars": { "POSTHOG_HOST": "https://us.i.posthog.com" },
  "routes": [{ "pattern": "stubs.talix.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
