{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "node_modules/.tmp/worker",
    "lib": ["ES2023"],
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "src/worker",
    "src/shared",
    "test/worker",
    // The Ticket module and what it imports run in both runtimes; the e2e test needs them here.
    "src/client/ticket.ts",
    "src/client/api.ts",
    "src/client/crypto.ts"
  ]
}
